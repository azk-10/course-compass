# Required for the browser bundle (must exist at BUILD time on Vercel/Netlify)
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project>"

# Required for SSR / server functions (runtime)
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Required only for writing sales leads (server-side, never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Optional: enables the AI merge judge. Without it the app falls back to the
# local classifier automatically.
LOVABLE_API_KEY=""

# Vercel only: build the server bundle for Vercel instead of the default target.
# NITRO_PRESET="vercel"
